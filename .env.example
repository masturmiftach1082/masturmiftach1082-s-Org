# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# Client-side Publishable credentials (accessible by Vite & Next.js frontend):
VITE_SUPABASE_URL="https://emdjxbjhrlqsficqyors.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_j01ZRuz0bWZhX0g_hpaeCQ_1mbIPdjY"
NEXT_PUBLIC_SUPABASE_URL="https://emdjxbjhrlqsficqyors.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_j01ZRuz0bWZhX0g_hpaeCQ_1mbIPdjY"

# Server-side Secret credentials (kept in backend only, never exposed in client bundle):
SUPABASE_URL="https://emdjxbjhrlqsficqyors.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_j01ZRuz0bWZhX0g_hpaeCQ_1mbIPdjY"
SUPABASE_SECRET_KEY="MY_SUPABASE_SECRET_KEY"
SUPABASE_JWKS_URL="https://emdjxbjhrlqsficqyors.supabase.co/auth/v1/.well-known/jwks.json"
